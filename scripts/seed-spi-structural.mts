const ORIGINALITY_NOTE =
  "ユーザー提供のオリジナル問題（一般知識ベースの創作文）。市販教材・書籍からの引用なし。";

function escapeSql(value: string): string {
  return value.replace(/'/g, "''");
}

function buildInserts(category: string, subCategory: string, questions: StructureQuestion[]): string[] {
  return questions.map((q) => {
    const optionsJson = JSON.stringify(q.options);
    const explanationJson = JSON.stringify([q.explanation]);
    return `INSERT INTO questions (category, sub_category, title, question_text, options, correct_answer, explanation, difficulty, status, originality_note) VALUES ('${escapeSql(
      category
    )}', '${escapeSql(subCategory)}', NULL, '${escapeSql(q.questionText)}', '${escapeSql(
      optionsJson
    )}', ${q.correctAnswer}, '${escapeSql(explanationJson)}', 3, 'published', '${escapeSql(ORIGINALITY_NOTE)}');`;
  });
}

function main() {
  const lines = [
    ...buildInserts("structural", "文章の構造化", CHAPTER1),
    ...buildInserts("structural", "分類・グループ化", CHAPTER2),
    ...buildInserts("structural", "分類・グループ化", CHAPTER3),
  ];

  writeFileSync(new URL("./seed_spi_structural.sql", import.meta.url), lines.join("\n") + "\n");
  console.log(`Generated ${lines.length} INSERT statements (10 + 10 + 5).`);
}

main();
