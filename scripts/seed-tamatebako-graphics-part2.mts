const CATEGORY = "tamatebako_math";
const SUB_CATEGORY = "図表の読み取り";
const ORIGINALITY_NOTE =
  "ユーザー提供のオリジナル図表問題（一般知識ベースの創作データ・グラフ画像）。市販教材・書籍からの引用なし。";

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function main() {
  const payload = QUESTIONS.map((q) => {
    // choices[0]が正解。インデックス付きでシャッフルしてから、シャッフル後の正解位置を求める。
    const indexed = q.choices.map((text, i) => ({ text, isCorrect: i === 0 }));
    const shuffled = shuffle(indexed);
    const correctAnswer = shuffled.findIndex((c) => c.isCorrect);
    return {
      category: CATEGORY,
      subCategory: SUB_CATEGORY,
      title: q.title,
      questionText: q.questionText,
      options: shuffled.map((c) => c.text),
      correctAnswer,
      explanation: [q.explanation],
      difficulty: 3,
      status: "published",
      originalityNote: ORIGINALITY_NOTE,
      imageDataUri: q.imageDataUri,
    };
  });

  writeFileSync(
    new URL("./seed_tamatebako_graphics_part2.json", import.meta.url),
    JSON.stringify({ questions: payload })
  );
  console.log(`Generated payload for ${payload.length} questions.`);
}

main();
