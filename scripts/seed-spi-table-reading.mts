const CATEGORY = "non_verbal";
const SUB_CATEGORY = "資料の読み取り";
const ORIGINALITY_NOTE =
  "ユーザー提供のオリジナル問題（一般知識ベースの創作文）。市販教材・書籍からの引用なし。";

function escapeSql(value: string): string {
  return value.replace(/'/g, "''");
}

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function main() {
  const lines = QUESTIONS.map((q) => {
    const indexed = q.options.map((text, i) => ({ text, isCorrect: i === q.correctIndex }));
    const shuffled = shuffle(indexed);
    const correctAnswer = shuffled.findIndex((c) => c.isCorrect);
    const optionsJson = JSON.stringify(shuffled.map((c) => c.text));
    const explanationJson = JSON.stringify(q.explanation);
    const tablesJson = JSON.stringify(q.tables);
    return `INSERT INTO questions (category, sub_category, title, question_text, tables_json, options, correct_answer, explanation, difficulty, status, originality_note) VALUES ('${escapeSql(
      CATEGORY
    )}', '${escapeSql(SUB_CATEGORY)}', NULL, '${escapeSql(q.questionText)}', '${escapeSql(
      tablesJson
    )}', '${escapeSql(optionsJson)}', ${correctAnswer}, '${escapeSql(explanationJson)}', 3, 'published', '${escapeSql(ORIGINALITY_NOTE)}');`;
  });

  writeFileSync(new URL("./seed_spi_table_reading.sql", import.meta.url), lines.join("\n") + "\n");
  console.log(`Generated ${lines.length} INSERT statements.`);
}

main();
